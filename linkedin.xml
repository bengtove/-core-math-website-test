---
layout: null
permalink: /linkedin.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>CoRE-Math — LinkedIn news</title>
    <link>{{ '/' | absolute_url | xml_escape }}</link>
    <description>New CoRE-Math news eligible for LinkedIn publication. Partner mentions must be configured and verified in Zapier.</description>
    <language>en</language>
    <atom:link href="{{ '/linkedin.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml" />
    {% for post in site.posts %}
      {% unless site.data.linkedin_history contains post.linkedin_id or post.linkedin == false %}
        {% if post.linkedin_id %}
          {% capture summary %}{% include news-card-excerpt.html post=post %}{% endcapture %}
          {% assign image = site.data.linkedin_images[post.linkedin_id] %}
          <item>
            <title>{{ post.title | xml_escape }}</title>
            <description>{{ summary | strip | xml_escape }}</description>
            <link>{{ post.url | absolute_url | xml_escape }}</link>
            <guid isPermaLink="false">urn:uuid:{{ post.linkedin_id | xml_escape }}</guid>
            <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
            {% if image %}
              <media:content url="{{ image.url | absolute_url | xml_escape }}" type="{{ image.type }}" medium="image" />
              {% if image.length %}<enclosure url="{{ image.url | absolute_url | xml_escape }}" length="{{ image.length }}" type="{{ image.type }}" />{% endif %}
            {% endif %}
          </item>
        {% endif %}
      {% endunless %}
    {% endfor %}
  </channel>
</rss>
